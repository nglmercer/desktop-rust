{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": [
      "**/*.{ts,tsx,js,jsx,mts,mjs,cjs,json,scss,css,yaml,yml}",
      "!**/node_modules/**",
      "!dist/**",
      "!out/**",
      "!vendor/**",
      "!gemoji/**",
      "!app/static/common/**",
      "!app/test/fixtures/**",
      "!app/static/logos/prod/**/*.json",
      "!app/static/logos/dev/**/*.json",
      "!**/package-lock.json",
      "!pnpm-lock.yaml",
      "!rust/target/**",
      "!rust/crates/core/src/repo_rules/re2js.js",
      "!**/coverage/**",
      "!playwright-videos/**",
      "!.github/workflows/issue-triage.lock.yml",
      "!app/styles/ui/_dialog.scss"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "overrides": [
    {
      "includes": ["app/styles/**/*.scss", "app/src/crash/styles/*.scss"],
      "linter": {
        "enabled": false
      },
      "css": {
        "formatter": {
          "lineWidth": 200,
          "quoteStyle": "single"
        }
      }
    },
    {
      "includes": ["app/styles/ui/_dialog.scss"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["**/*.yaml", "**/*.yml"],
      "linter": {
        "enabled": false
      },
      "yaml": {
        "formatter": {
          "quoteStyle": "single"
        }
      }
    },
    {
      "includes": [".github/workflows/issue-triage.lock.yml"],
      "formatter": {
        "enabled": false
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5",
      "arrowParentheses": "asNeeded"
    }
  },
  "linter": {
    "enabled": false
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}
