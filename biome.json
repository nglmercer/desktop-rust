{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": [
      "script/test.mts",
      "vitest.config.ts",
      "app/test/vitest-setup.ts",
      "rust/tests/github-cli.test.ts",
      "rust/tests/branch-name-rules.test.ts",
      "rust/tests/repository-accounts.test.ts",
      "rust/tests/github-create.test.ts",
      "rust/tests/git-http-fixture.test.ts",
      "rust/tests/git-credentials.test.ts",
      "rust/tests/git-credential-policy.test.ts",
      "rust/tests/fixtures/branch-rules-gh.ts",
      "rust/tests/fixtures/accounts.ts",
      "rust/tests/fixtures/account-bridge.ts",
      "rust/tests/fixtures/account-gh.ts",
      "rust/tests/fixtures/creation.ts",
      "rust/tests/fixtures/creation-gh.ts",
      "rust/tests/fixtures/creation-api-worker.ts",
      "rust/tests/fixtures/git-http.ts",
      "rust/tests/fixtures/git-http-worker.ts",
      "rust/tests/fixtures/credentials.ts",
      "rust/tests/fixtures/native-credential-helper.ts",
      "rust/tests/fixtures/native-ssh.ts",
      "rust/tests/fixtures/credential-probe.ts",
      "rust/tests/branch-rules-oracle/*.mts",
      "rust/tests/branch-rules-oracle/*.test.ts",
      "script/draft-release/format-json.ts",
      "script/draft-release/format-json-cli.ts",
      "script/draft-release/format-json.test.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5",
      "arrowParentheses": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}
