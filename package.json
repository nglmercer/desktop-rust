{
  "name": "github-desktop-build",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/desktop/desktop.git"
  },
  "description": "GitHub Desktop build dependencies",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "check:ipc": "tsc -P rust/crates/desktop-app/web/tsconfig.json",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "compile:script": "tsc -P script/tsconfig.json",
    "test": "node --import @oxc-node/core/register script/test.mts",
    "test:unit": "node --import @oxc-node/core/register script/test.mts",
    "test:script": "node --import @oxc-node/core/register script/test.mts script",
    "test:oxlint": "node --import @oxc-node/core/register script/test.mts oxlint-rules/tests",
    "test:setup": "node --import @oxc-node/core/register script/test-setup.ts",
    "lint": "pnpm lint:oxlint && pnpm format:check",
    "lint:oxlint": "oxlint --config=.oxlintrc.json app/src app/test script rust/tests oxlint-rules",
    "lint:security": "oxlint --config=.oxlint.security.json app/src app/test script rust/tests oxlint-rules",
    "lint:fix": "oxlint --fix --config=.oxlintrc.json app/src app/test script rust/tests oxlint-rules && biome format --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "markdownlint": "node --import @oxc-node/core/register node_modules/markdownlint-cli/markdownlint.js **/*.{md,mdx} --config .markdownlint.json --rules .markdownlint-rules.ts --ignore node_modules --ignore app/node_modules --ignore gemoji --ignore dist --ignore out --ignore rust/target --ignore app/static/common --ignore app/test/fixtures",
    "start": "cross-env NODE_ENV=development node --import @oxc-node/core/register script/start-rust.ts",
    "start:rust": "cross-env NODE_ENV=development node --import @oxc-node/core/register script/start-rust.ts",
    "start:prod": "cross-env NODE_ENV=production RELEASE_CHANNEL=production node --import @oxc-node/core/register script/start-rust-package.ts",
    "build:dev": "cross-env NODE_ENV=development pnpm vite:build && cross-env NODE_ENV=development DESKTOP_REQUIRE_NATIVE_PLATFORM=1 cargo build --locked -p desktop-app -p desktop-cli --features desktop-cli/embedded-ui",
    "build:prod": "node --import @oxc-node/core/register script/build-rust-production.ts",
    "package": "cross-env NODE_ENV=production RELEASE_CHANNEL=production DESKTOP_RUST_PACKAGE_PROFILE=release node --import @oxc-node/core/register script/package-rust.ts",
    "package:rust": "node --import @oxc-node/core/register script/package-rust.ts",
    "migration:status": "node --import @oxc-node/core/register script/migration-metrics.ts",
    "migration:check": "node --import @oxc-node/core/register script/migration-metrics.ts --check",
    "migration:baseline": "node --import @oxc-node/core/register script/migration-metrics.ts --update",
    "generate-octicons": "node --import @oxc-node/core/register script/generate-octicons.ts",
    "generate-example-usage-data": "node --import @oxc-node/core/register script/generate-example-usage-data.mts",
    "clean-slate": "rimraf out node_modules app/node_modules && pnpm install --frozen-lockfile --ignore-scripts",
    "rebuild-hard:dev": "rimraf out node_modules app/node_modules && pnpm install --frozen-lockfile --ignore-scripts && git submodule update --init --recursive && pnpm build:dev",
    "rebuild-hard:prod": "rimraf out node_modules app/node_modules && pnpm install --frozen-lockfile --ignore-scripts && git submodule update --init --recursive && pnpm build:prod",
    "draft-release": "node --import @oxc-node/core/register script/draft-release/index.ts",
    "draft-release:format": "node --import @oxc-node/core/register script/draft-release/format-json-cli.ts changelog.json app/package.json && pnpm validate-changelog",
    "draft-release:pr": "node --import @oxc-node/core/register script/draft-release/draft-pull-request.ts",
    "validate-changelog": "node --import @oxc-node/core/register script/validate-changelog.ts",
    "vite:dev": "vite --configLoader runner",
    "vite:build": "vite build --configLoader runner && vite build --configLoader runner -c vite.highlighter.config.ts && vite build --configLoader runner -c vite.ipc-shim.config.ts",
    "vite:preview": "vite preview --configLoader runner"
  },
  "author": {
    "name": "GitHub, Inc.",
    "email": "opensource+desktop@github.com",
    "url": "https://desktop.github.com/"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.17.0"
  },
  "overrides": {
    "@github/markdownlint-github": {
      "markdown-it": "14.3.3"
    },
    "@types/react-css-transition-replace": {
      "@types/react": "$@types/react"
    },
    "markdownlint-cli": {
      "js-yaml": "5.4.3",
      "smol-toml": "1.9.1"
    },
    "@types/glob": {
      "@types/minimatch": "3.0.5"
    }
  },
  "dependencies": {
    "@floating-ui/core": "^1.8.0",
    "@floating-ui/react-dom": "^2.1.9",
    "@primer/octicons": "^19.28.1",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^7.0.3",
    "fake-indexeddb": "^6.0.0",
    "front-matter": "^2.3.0",
    "jsdom": "^26.0.0",
    "legal-eagle": "0.16.0",
    "parse-dds": "^1.2.1",
    "path-browserify": "^1.0.1",
    "process-proxy": "^0.6.0",
    "rimraf": "^6.0.1",
    "sass": "^1.27.0",
    "semver": "^7.6.3",
    "typescript": "7.0.2",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@github/markdownlint-github": "^0.8.3",
    "@oxc-node/core": "1.0.2",
    "@types/codemirror": "^5.60.15",
    "@types/deep-equal": "^1.0.1",
    "@types/dompurify": "^2.3.1",
    "@types/event-kit": "^2.4.1",
    "@types/fuzzaldrin-plus": "^0.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/legal-eagle": "^0.15.0",
    "@types/lodash": "^4.17.25",
    "@types/marked": "^4.0.1",
    "@types/memoize-one": "^3.1.1",
    "@types/node": "22.10.9",
    "@types/parse-dds": "^1.0.3",
    "@types/react": "^16.14.62",
    "@types/react-css-transition-replace": "^2.1.3",
    "@types/react-dom": "^16.8.2",
    "@types/react-transition-group": "^4.4.0",
    "@types/react-virtualized": "^9.7.12",
    "@types/reserved-words": "^0.1.0",
    "@types/semver": "^5.5.0",
    "@types/split2": "^4.2.3",
    "@types/textarea-caret": "^3.0.0",
    "@types/untildify": "^3.0.0",
    "diff": "^8.0.3",
    "markdownlint-cli": "^0.49.1",
    "oxlint": "1.94.0",
    "playwright": "^1.58.2",
    "reserved-words": "^0.1.2",
    "tslib": "^2.9.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "5.1.0"
  }
}
