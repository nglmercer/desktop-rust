{
  "name": "github-desktop-build",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/desktop/desktop.git"
  },
  "description": "GitHub Desktop build dependencies",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "check:eslint": "tsc -P eslint-rules/",
    "check:ipc": "tsc -P rust/crates/desktop-app/web/tsconfig.json",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "test:eslint": "node --import @oxc-node/core/register script/test.mts eslint-rules",
    "test:script": "node --import @oxc-node/core/register script/test.mts script",
    "test": "node --import @oxc-node/core/register script/test.mts",
    "test:unit": "node --import @oxc-node/core/register script/test.mts",
    "test:setup": "node --require ./script/ts-register.cjs script/test-setup.ts",
    "start": "cross-env NODE_ENV=development node --require ./script/ts-register.cjs script/start-rust.ts",
    "start:rust": "cross-env NODE_ENV=development node --require ./script/ts-register.cjs script/start-rust.ts",
    "start:prod": "cross-env NODE_ENV=production RELEASE_CHANNEL=production node --require ./script/ts-register.cjs script/start-rust-package.ts",
    "build:dev": "cross-env NODE_ENV=development pnpm vite:build && cross-env NODE_ENV=development DESKTOP_REQUIRE_NATIVE_PLATFORM=1 cargo build --locked -p desktop-app -p desktop-cli --features desktop-cli/embedded-ui",
    "build:prod": "node --require ./script/ts-register.cjs script/build-rust-production.ts",
    "package": "cross-env NODE_ENV=production RELEASE_CHANNEL=production DESKTOP_RUST_PACKAGE_PROFILE=release node --require ./script/ts-register.cjs script/package-rust.ts",
    "package:rust": "node --require ./script/ts-register.cjs script/package-rust.ts",
    "generate-octicons": "node --require ./script/ts-register.cjs script/generate-octicons.ts",
    "generate-example-usage-data": "node --import @oxc-node/core/register script/generate-example-usage-data.mts",
    "compile:script": "tsc -P script/tsconfig.json",
    "lint": "npm run prettier && npm run lint:src && npm run lint:biome --",
    "lint:biome": "biome check .",
    "lint:fix": "npm run prettier -- --write && npm run lint:src:fix && biome check --write . --",
    "markdownlint": "node --import @oxc-node/core/register node_modules/markdownlint-cli/markdownlint.js **/*.{md,mdx} --config .markdownlint.json --rules .markdownlint-rules.ts --ignore node_modules --ignore gemoji",
    "prettier": "prettier --check \"./**/*.{ts,tsx,js,json,jsx,scss,html,yaml,yml}\" \"./eslint-rules/**/*.mts\"",
    "lint:src": "npm run lint:security && npm run eslint-check && npm run eslint --",
    "lint:src:fix": "npm run lint:security && npm run eslint -- --fix",
    "lint:security": "tsc -p biome-rules/tsconfig.json && biome lint --config-path=biome.security.json . --diagnostic-level=error",
    "eslint": "eslint --cache --rulesdir ./eslint-rules \"./eslint-rules/**/*.{js,mts}\" \"./script/**/*.ts{,x}\" \"./app/{src,typings,test}/**/*.{j,t}s{,x}\" \"./changelog.json\"",
    "eslint-check": "eslint --print-config .eslintrc.* | eslint-config-prettier-check",
    "clean-slate": "rimraf out node_modules app/node_modules && npm ci",
    "rebuild-hard:dev": "rimraf out node_modules app/node_modules && pnpm install --frozen-lockfile --ignore-scripts && git submodule update --init --recursive && pnpm build:dev",
    "rebuild-hard:prod": "rimraf out node_modules app/node_modules && pnpm install --frozen-lockfile --ignore-scripts && git submodule update --init --recursive && pnpm build:prod",
    "draft-release": "node --require ./script/ts-register.cjs script/draft-release/index.ts",
    "draft-release:format": "node --require ./script/ts-register.cjs script/draft-release/format-json-cli.ts changelog.json app/package.json && npm run validate-changelog --",
    "draft-release:pr": "node --require ./script/ts-register.cjs script/draft-release/draft-pull-request.ts",
    "validate-changelog": "node --require ./script/ts-register.cjs script/validate-changelog.ts",
    "vite:dev": "vite --configLoader runner",
    "vite:build": "vite build --configLoader runner && vite build --configLoader runner -c vite.highlighter.config.ts && vite build --configLoader runner -c vite.ipc-shim.config.ts",
    "vite:preview": "vite preview --configLoader runner",
    "pnpm:install": "pnpm install"
  },
  "author": {
    "name": "GitHub, Inc.",
    "email": "opensource+desktop@github.com",
    "url": "https://desktop.github.com/"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">= 11.17.0"
  },
  "overrides": {
    "@github/markdownlint-github": {
      "markdown-it": "14.3.3"
    },
    "@types/react-css-transition-replace": {
      "@types/react": "$@types/react"
    },
    "markdownlint-cli": {
      "js-yaml": "5.4.3",
      "smol-toml": "1.9.1"
    },
    "@types/glob": {
      "@types/minimatch": "3.0.5"
    }
  },
  "dependencies": {
    "@floating-ui/core": "^1.8.0",
    "@floating-ui/react-dom": "^2.1.9",
    "@primer/octicons": "^19.28.1",
    "@types/which": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript-eslint/typescript-estree": "^8.70.0",
    "@typescript-eslint/utils": "^8.70.0",
    "@vitejs/plugin-react": "^6.3.0",
    "chalk": "^5.3.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-jsdoc": "^50.6.2",
    "eslint-plugin-json": "^2.1.1",
    "eslint-plugin-react": "^7.37.5",
    "fake-indexeddb": "^6.0.0",
    "front-matter": "^2.3.0",
    "glob": "^7.1.2",
    "global-jsdom": "^26.0.0",
    "jsdom": "^26.0.0",
    "legal-eagle": "0.16.0",
    "parse-dds": "^1.2.1",
    "path-browserify": "^1.0.1",
    "preact": "^10.0.0",
    "prettier": "^2.6.0",
    "process-proxy": "^0.6.0",
    "rimraf": "^6.0.1",
    "sass": "^1.27.0",
    "semver": "^7.6.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@biomejs/runtime": "2.6.7",
    "@github/markdownlint-github": "^0.8.3",
    "@oxc-node/core": "1.0.2",
    "@playwright/test": "^1.58.2",
    "@types/byline": "^4.2.31",
    "@types/codemirror": "^5.60.15",
    "@types/deep-equal": "^1.0.1",
    "@types/dompurify": "^2.3.1",
    "@types/eslint": "^8.4.1",
    "@types/estree": "^0.0.49",
    "@types/event-kit": "^2.4.1",
    "@types/express": "^4.11.0",
    "@types/fuzzaldrin-plus": "^0.0.1",
    "@types/glob": "^5.0.35",
    "@types/jsdom": "^21.1.7",
    "@types/klaw-sync": "^6.0.0",
    "@types/legal-eagle": "^0.15.0",
    "@types/lodash": "^4.17.25",
    "@types/marked": "^4.0.1",
    "@types/memoize-one": "^3.1.1",
    "@types/minimist": "^1.2.5",
    "@types/node": "22.10.9",
    "@types/parse-dds": "^1.0.3",
    "@types/plist": "^3.0.2",
    "@types/react": "^16.14.62",
    "@types/react-css-transition-replace": "^2.1.3",
    "@types/react-dom": "^16.8.2",
    "@types/react-transition-group": "^4.4.0",
    "@types/react-virtualized": "^9.7.12",
    "@types/request": "^2.0.9",
    "@types/reserved-words": "^0.1.0",
    "@types/semver": "^5.5.0",
    "@types/source-map-support": "^0.5.2",
    "@types/split2": "^4.2.3",
    "@types/strip-ansi": "^3.0.0",
    "@types/textarea-caret": "^3.0.0",
    "@types/to-camel-case": "^1.0.0",
    "@types/triple-beam": "^1.3.2",
    "@types/ua-parser-js": "^0.7.30",
    "@types/untildify": "^3.0.0",
    "@types/username": "^3.0.0",
    "@types/webgl2": "^0.0.11",
    "diff": "^8.0.3",
    "eslint-plugin-github": "^5.1.5",
    "markdownlint-cli": "^0.49.1",
    "node-test-github-reporter": "^1.3.2",
    "playwright": "^1.58.2",
    "reserved-words": "^0.1.2",
    "tslib": "^2.9.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "5.1.0"
  }
}
